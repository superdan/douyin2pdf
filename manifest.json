{
  "manifest_version": 3,
  "name": "抖音图文转PDF",
  "description": "一键提取抖音图文（note）里的全部试卷/图片，本地合成高清 A4 PDF 并保存。数据不外传，无外部依赖。",
  "version": "1.1.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "offscreen"
  ],
  "host_permissions": [
    "https://www.douyin.com/*",
    "https://*.douyinpic.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.douyin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "抖音图文转PDF",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
